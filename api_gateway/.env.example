# ===== LianLian Pay (Thailand) config =====
# ชื่อตัวแปรตรงกับที่เห็นในพอร์ทัล LianLian

# sandbox | production
LIANLIANPAY_ENV=sandbox

# Merchant ID (เลข 18 หลัก ขึ้นต้น 14) — ดูที่ Home / ข้อมูลบัญชี
# sandbox กับ production เป็นคนละเลข ต้องหยิบจากพอร์ทัลที่ตรงกับ LIANLIANPAY_ENV
#   sandbox    -> https://sandbox-th-merchant.lianlianpay-inc.com/user/login
#   production -> https://merchant.lianlianpay.co.th/user/login
# ใส่สลับกันเมื่อไหร่ จะได้ error 404002 Merchant not found
MERCHANT_ID=

# Store ID (ไม่บังคับ) — ดูที่เมนู Store management
# MERCHANT_STORE_ID=142023010100009002

# --- คีย์ 2 ตัว (อย่าสลับกัน!) ---

# 1) PRIVATE key ของ "เรา" ที่ใช้เซ็น request
#    = ไฟล์ merchant_private.pem ที่สร้างเอง (public half ของมันคือ "Merchant public key" ที่อัปในพอร์ทัล)
#    แนะนำให้ชี้ไปที่ไฟล์ .pem โดยตรง จะได้ไม่ copy ผิด
MERCHANT_PRIVATE_KEY_FILE=/Users/teerawatpinchai/Desktop/api_gateway/merchant_private.pem
# หรือวางเนื้อ base64 ตรงๆ (ขึ้นต้นด้วย MIIE...) แบบนี้แทน:
# MERCHANT_PRIVATE_KEY=MIIEvgIBADANBgkqhkiG9w0BAQEFAASC...

# 2) PUBLIC key ของ "LianLianPay" ใช้ verify ลายเซ็น webhook
#    = ค่า "LianLianPay public key" ในหน้า Dev config (ขึ้นต้น MIIB...)
#    ‼️ คีย์นี้ก็เป็นคนละตัวระหว่าง sandbox กับ production เหมือนกัน
#    ถ้าใช้คีย์ผิด: สร้าง QR ได้ ลูกค้าจ่ายเงินจริงได้ แต่ webhook verify ไม่ผ่าน
#    → ระบบไม่รู้ว่าจ่ายแล้ว ลูกค้าเสียเงินฟรี
LIANLIANPAY_PUBLIC_KEY=MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIB...วางค่าจากพอร์ทัล...
# LIANLIANPAY_PUBLIC_KEY_FILE=/Users/teerawatpinchai/Desktop/api_gateway/lianlianpay_public.pem

# --- URL สำหรับผลการชำระเงิน ---
NOTIFY_URL=https://shot24.shop/webhook/lianlian
REDIRECT_URL=https://shot24.shop/payment/return

# override gateway url ถ้าจำเป็น
# GATEWAY_URL=https://sandbox-th.lianlianpay-inc.com/gateway

# --- Database สำหรับ log การโอน (payment gateway เท่านั้น) ---
# MySQL / phpMyAdmin:
#   mysql+pymysql://USER:PASSWORD@HOST:3306/DBNAME?charset=utf8mb4
# หรือ SQLite (ลองเร็วๆ ไม่ต้องตั้ง server): sqlite:///payment_gateway.db
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/paygw?charset=utf8mb4
