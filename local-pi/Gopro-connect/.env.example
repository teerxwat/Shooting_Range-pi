# ===== Lane / Station ID =====
# เลนที่ Pi เครื่องนี้ติดตั้งอยู่ (1, 2, 3, ...) — ใช้เป็นเลขนำหน้า session code
# เช่น LANE_ID=2 → S2-0001, S2-0002, ...
# ‼️ ต้องตั้งไม่ซ้ำกับ Pi เครื่องอื่นที่อัปคลิปขึ้นคลาวด์เดียวกัน (CLOUD_URL เดียวกัน)
#    ไม่งั้น session code จะชนกัน (เช่นทุกเครื่องได้ S1-0001 เหมือนกัน) แล้ววิดีโอของลูกค้า
#    คนละเลนจะไปรวมเป็น session เดียวกันบนคลาวด์
LANE_ID=1

# ===== Display / UDP Ports =====
UDP_LISTEN_PORT=12344     # Mac รับจาก ESP32 (button + discovery)
UDP_DISPLAY_PORT=12345    # Mac ส่งไป ESP32 (display commands)

# ===== ESP32 MAC Address per Channel =====
# ดู MAC ได้จาก Serial Monitor ตอน ESP32 บูต ("MAC: AA:BB:CC:DD:EE:FF")
ESP32_CH1_MAC=F4:2D:C9:70:70:2C            # ใส่ MAC ของ ESP32 เลน 1
# เลน 2-4 ที่ยังไม่ใช้ ปล่อยว่างไว้ได้ แต่ห้ามใส่คอมเมนต์ต่อท้ายค่าว่าง
# (python-dotenv จะอ่านข้อความคอมเมนต์เข้าไปเป็นค่าตัวแปรจริงๆ)
ESP32_CH2_MAC=
ESP32_CH3_MAC=
ESP32_CH4_MAC=

# ===== Global =====
PORT=8080
PRESET_ID=262144          # 262144 = Burst Slo-Mo (PRESET_TITLE_SLOMO)
RECORD_SECONDS=10         # ระยะเวลาอัดต่อ 1 รอบ (วินาที)
# (ทางเลือก) ความละเอียด/fps ที่ตั้งให้กล้องหลังโหลด preset — ไม่ใส่ = ใช้ค่าของ preset (ตอนนี้ 4K 240fps)
# resolution: 1=4K 4=2.7K 9=1080 | fps: 0=240 1=120 5=60 8=30
# อัด 1080p ตรงจากกล้องแปลงไฟล์เร็วพอๆ กับเปิด TRANSCODE_HWACCEL=drm แต่ภาพคมน้อยกว่าย่อจาก 4K
# VIDEO_RES_CODE=9
# VIDEO_FPS_CODE=0
DOWNLOAD_ROOT=downloads
DOWNLOAD_WAIT=12          # รอไฟล์ finalize สูงสุดกี่วินาที
DOWNLOAD_RETENTION_DAYS=7 # ไฟล์ใน downloads/ เก่ากว่ากี่วัน → cleanup_downloads.py ลบทิ้ง (cron รายวัน)
NUM_CHANNELS=4
CAMS_PER_CHANNEL=1        # ตอนนี้ใช้ 1 กล้อง/ช่อง (เปลี่ยนกลับเป็น 2 เมื่อติดกล้องเพิ่ม)

# ===== Detect (ค่าจูนการตรวจจับท่ายิง — แก้แล้วรีสตาร์ท server) =====
DETECT_AIM_DIR=1               # ทิศที่ผู้ยิงหัน: 1 = หันขวาของภาพ, -1 = หันซ้าย, 0 = ได้ทั้งสองทิศ
DETECT_STABLE_SECONDS=3.0      # ต้องค้างท่ากี่วินาทีถึงเริ่มนับถอยหลัง
DETECT_COOLDOWN=5.0            # เว้นกี่วินาทีก่อน trigger ซ้ำได้
DETECT_ARM_STRAIGHT_DEG=150    # ปืนสั้น: ข้อศอกต้องเหยียดอย่างน้อย (องศา)
DETECT_HORIZ_TOL_DEG=25        # ปืนสั้น: แขนเบนจากแนวนอนได้ไม่เกิน (องศา)
DETECT_RIFLE_FRONT_MIN_DEG=60  # ปืนยาว: กันแค่แขนหน้าพับสุด (รองรับท่า compact แขนงอ)
DETECT_RIFLE_HORIZ_TOL=45      # ปืนยาว: แขนหน้าเบนจากแนวนอนได้ไม่เกิน
DETECT_RIFLE_REAR_MAX_DEG=130  # ปืนยาว: แขนหลัง (มือไก) ต้องงอ — ข้อศอกน้อยกว่านี้
DETECT_RIFLE_REAR_RAISE_R=0.7  # ปืนยาว: ข้อมือแขนหลังห้อยใต้ไหล่ได้ไม่เกิน (เท่าของความยาวแขน)
DETECT_RIFLE_MIN_SEP_R=0.25    # ปืนยาว: มือ 2 ข้างต้องแยกห่างกันขั้นต่ำ (กันท่าถือมือถือ 2 มือ)
DETECT_KP_CONF=0.3             # ความมั่นใจขั้นต่ำของ keypoint (ลด = จับง่ายขึ้นแต่มั่วขึ้น)
DETECT_MOVE_TOL_R=0.5          # ขยับมือได้แค่ไหนโดยไม่รีเซ็ตเวลานับ
DETECT_USE_GUN=false           # true = ต้องเห็นวัตถุ(ปืน)ใกล้มือด้วยถึง trigger
# DETECT_TORCH_THREADS=3       # thread ของ YOLO บน CPU (ค่าเริ่มต้น = จำนวน core - 1 เว้นไว้ให้ ffmpeg)

# ===== ภาพสด / แปลงไฟล์ =====
LIVE_PRESET_ID=0               # preset ที่โหลดเมื่อกล้องแจ้งว่ายังส่งภาพสดไม่ได้ (status 55 = 0)
# hardware decode ตอนแปลงไฟล์ — Pi 5 วัดแล้ว decode 4K เร็วขึ้น ~2.8 เท่า ภาพเหมือนเดิมทุกพิกเซล (SSIM 1.0)
# ใช้ไม่ได้จะถอยไปแปลงด้วย CPU ให้เอง
TRANSCODE_HWACCEL=drm
# TRANSCODE_PRESET=superfast   # x264 preset (ค่าเริ่มต้น superfast) — ultrafast เร็วกว่าแต่ไฟล์ใหญ่และคุณภาพต่อขนาดต่ำกว่า

# ===== Channel 1 =====
# CH1_CAM1_IP=172.21.168.51
# CH1_CAM1_ENABLED=true
# CH1_CAM2_IP=172.27.185.51
# CH1_CAM2_ENABLED=true

CH1_CAM1_IP=172.27.185.51
CH1_CAM1_ENABLED=true
CH1_CAM2_IP=172.21.168.51
CH1_CAM2_ENABLED=true    # ยังไม่ได้เสียบ cam2 — เปิดเมื่อต่อกล้องจริง

# ===== Channel 2 =====
CH2_CAM1_IP=172.21.168.51
CH2_CAM1_ENABLED=true     # กล้องตัวที่ 2 → ใช้เป็นกล้องของช่อง 2
CH2_CAM2_IP=172.22.100.52
CH2_CAM2_ENABLED=false

# ===== Channel 3 =====
CH3_CAM1_IP=172.23.100.51
CH3_CAM1_ENABLED=false
CH3_CAM2_IP=172.23.100.52
CH3_CAM2_ENABLED=false

# ===== Channel 4 =====
CH4_CAM1_IP=172.24.100.51
CH4_CAM1_ENABLED=false
CH4_CAM2_IP=172.24.100.52
CH4_CAM2_ENABLED=false
# ===== อัปคลิปขึ้นคลาวด์ (เว็บดาวน์โหลดของลูกค้า) =====
CLOUD_URL=https://shot24.shop          # เว็บดาวน์โหลดของลูกค้า
# ต้องตรงกับ API_KEY ใน v2/server/.env บนเซิร์ฟเวอร์ — ห้ามใส่คอมเมนต์ต่อท้ายค่าว่าง
# (python-dotenv จะอ่านข้อความคอมเมนต์เข้าไปเป็นค่า key ผิดๆ แล้วทุก request จะ error)
CLOUD_API_KEY=
CLOUD_UPLOAD=1                          # 0 = ปิด เก็บคลิปไว้ในเครื่องอย่างเดียว
DELETE_AFTER_UPLOAD=1                  # อัปคลาวด์สำเร็จ → ลบไฟล์บนกล้อง GoPro ทันที (กันเมมเต็ม), 0 = ไม่ลบ

# ===== จบการใช้งาน / ค่าคอมมิชชั่นผู้ดูแล (ดู server/STAFF_COMMISSION_API.md) =====
# รายชื่อผู้ดูแลมาจากคลาวด์ก่อน ถ้าคลาวด์ยังไม่มี API รายชื่อ → ใช้ไฟล์นี้แทน (คัดจาก staff.example.json)
# STAFF_FILE=staff.json
# SESSION_REPORT_SYNC=60                # ลองส่งรายงานจบเซสชันที่ค้างขึ้นคลาวด์ทุกกี่วินาที
