# คัดลอกเป็น .env แล้วแก้ค่า
PORT=8080

# ── ฐานข้อมูล MySQL (จำเป็น) ───────────────────────────
DATABASE_URL=mysql://shooting:รหัสผ่าน@localhost:3306/shooting

# ── ความลับ (บนเซิร์ฟเวอร์จริงต้องสุ่มใหม่: openssl rand -hex 32) ──
API_KEY=devkey                      # เครื่อง Mac ที่สนามใช้ยิง /api/ingest/*
JWT_SECRET=devsecret                # เซ็น token ลูกค้า + ลิงก์ดาวน์โหลด
ADMIN_KEY=devadmin                  # ดูสถิติ /api/admin/*

# ── ค่าใช้งาน ──────────────────────────────────────────
# ── ระบบชำระเงิน ───────────────────────────────────────
# เว้นว่าง = โหมดทดสอบ (กดจ่ายแล้วปลดล็อคเลย ไม่ตรวจอะไร)
# ใส่ค่า = เซิร์ฟเวอร์จะถาม payment API เองว่าจ่ายจริงไหม ยอดตรงไหม
PAYGW_URL=http://127.0.0.1:9999
PAYGW_API_KEY=                      # X-API-Key ของ payment API

RETENTION_DAYS=3                    # อายุไฟล์วิดีโอ (สถิติไม่ถูกลบ เก็บถาวร)
PRICE_PER_CLIP=250                  # บาท
WATERMARK_TEXT=700 SHOOTING RANGE   # ลายน้ำบน preview

# DATA_DIR=./data                   # ที่เก็บวิดีโอ
# FFMPEG=ffmpeg                     # ถ้า ffmpeg ไม่อยู่ใน PATH ใส่ path เต็ม
